{
  "name": "redis-on-workers",
  "version": "0.5.0",
  "description": "Connect to your Redis server using cloudflare:sockets",
  "keywords": [
    "cloudflare",
    "redis",
    "socket",
    "tcp",
    "typescript",
    "workers"
  ],
  "homepage": "https://github.com/kane50613/redis-on-workers",
  "bugs": {
    "url": "https://github.com/kane50613/redis-on-workers/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kane",
    "email": "kane@yeecord.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kane50613/redis-on-workers.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --format=github && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "knip-bun --no-config-hints",
    "tegami": "bun scripts/tegami.mts",
    "postinstall": "lefthook install",
    "publish-lint": "attw --pack . && publint --strict ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/bun": "^1.3.14",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "tegami": "^1.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@arrowood.dev/socket": "^0.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
